rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPlayerSave(data) {
      return data.keys().hasAll([
        'userId',
        'displayName',
        'currentNight',
        'completedNights',
        'night6Completed',
        'extrasUnlocked',
        'totalDeaths',
        'totalHoursSurvived',
        'bestNightPowerRemaining',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'userId',
        'displayName',
        'currentNight',
        'completedNights',
        'night6Completed',
        'extrasUnlocked',
        'totalDeaths',
        'totalHoursSurvived',
        'bestNightPowerRemaining',
        'createdAt',
        'updatedAt'
      ])
      && data.userId is string
      && data.userId == request.auth.uid
      && data.userId.size() >= 1
      && data.userId.size() <= 128
      && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.displayName is string
      && data.displayName.size() >= 1
      && data.displayName.size() <= 100
      && data.currentNight is int
      && data.currentNight >= 1
      && data.currentNight <= 6
      && data.completedNights is int
      && data.completedNights >= 0
      && data.completedNights <= 6
      && data.night6Completed is bool
      && data.extrasUnlocked is bool
      && data.extrasUnlocked == data.night6Completed
      && data.night6Completed == (data.completedNights == 6)
      && data.totalDeaths is int
      && data.totalDeaths >= 0
      && data.totalDeaths <= 100000
      && data.totalHoursSurvived is int
      && data.totalHoursSurvived >= 0
      && data.totalHoursSurvived <= 1000000
      && data.bestNightPowerRemaining is number
      && data.bestNightPowerRemaining >= 0
      && data.bestNightPowerRemaining <= 100
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /saves/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidPlayerSave(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().currentNight == 1
        && incoming().completedNights == 0
        && incoming().night6Completed == false
        && incoming().extrasUnlocked == false
        && incoming().totalDeaths == 0
        && incoming().totalHoursSurvived == 0
        && incoming().bestNightPowerRemaining == 0;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidPlayerSave(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['currentNight', 'updatedAt'])
            && incoming().currentNight == 1
          )
          ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'currentNight',
              'completedNights',
              'night6Completed',
              'extrasUnlocked',
              'totalHoursSurvived',
              'bestNightPowerRemaining',
              'updatedAt'
            ])
            && (
              incoming().completedNights == existing().completedNights
              || incoming().completedNights == existing().completedNights + 1
            )
            && incoming().totalHoursSurvived >= existing().totalHoursSurvived
            && incoming().bestNightPowerRemaining >= existing().bestNightPowerRemaining
          )
          ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'totalDeaths',
              'totalHoursSurvived',
              'updatedAt'
            ])
            && incoming().totalDeaths == existing().totalDeaths + 1
            && incoming().totalHoursSurvived >= existing().totalHoursSurvived
          )
          ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }
  }
}
